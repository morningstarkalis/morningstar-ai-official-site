{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "morningstar-ai-official-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morningstar-membership",
      "database_id": "028ea21c-486b-47af-8fec-b929d81f7045",
      "migrations_dir": "./migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "4cb678c5-a9a3-4d81-acc4-634e06a6affc"
      }
    ],
    "vars": {
      "MODEL_SERIES_ENABLED": "false",
      "MODEL_ORDER_REQUESTS_ENABLED": "false",
      "PROCESSOR_DPA_REVIEWED": "false",
      "CROSS_BORDER_REVIEWED": "false",
      "PRIVACY_RETENTION_APPROVED": "false",
      "CONSUMER_TERMS_REVIEWED": "false"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
